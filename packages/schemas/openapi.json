{
  "components": {
    "schemas": {
      "AcquireRequest": {
        "additionalProperties": false,
        "properties": {
          "sources_per_requirement": {
            "default": 1,
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Sources Per Requirement",
            "type": "integer"
          }
        },
        "title": "AcquireRequest",
        "type": "object"
      },
      "CompileRequest": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "deterministic",
                  "llm",
                  "auto"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "override": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Override"
          }
        },
        "title": "CompileRequest",
        "type": "object"
      },
      "DecideRequest": {
        "additionalProperties": false,
        "properties": {
          "evidence_set_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Set Id"
          }
        },
        "title": "DecideRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IntentCreate": {
        "additionalProperties": false,
        "properties": {
          "evidence_budget": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Budget"
          },
          "network": {
            "default": "monad",
            "maxLength": 32,
            "title": "Network",
            "type": "string"
          },
          "protected_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protected Amount"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "IntentCreate",
        "type": "object"
      },
      "IntentPreview": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "deterministic",
                  "llm",
                  "auto"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "IntentPreview",
        "type": "object"
      },
      "MarketUpdate": {
        "additionalProperties": false,
        "properties": {
          "asset": {
            "default": "TOKEN-X",
            "maxLength": 32,
            "title": "Asset",
            "type": "string"
          },
          "values": {
            "additionalProperties": true,
            "title": "Values",
            "type": "object"
          }
        },
        "required": [
          "values"
        ],
        "title": "MarketUpdate",
        "type": "object"
      },
      "ScenarioRun": {
        "additionalProperties": false,
        "properties": {
          "execute": {
            "default": true,
            "title": "Execute",
            "type": "boolean"
          },
          "stop_before": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Before"
          }
        },
        "title": "ScenarioRun",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\n**SUFFICIA \u2014 Evidence-Bound Execution for Autonomous Agents.**\n\nReasoning proposes. Evidence constrains. Policy decides. Authorization binds. Monad executes.\n\nFlow: `POST /intents` \u2192 `POST /intents/{id}/compile` (frozen Evidence Contract) \u2192 `POST /contracts/{id}/acquire`\n(x402-paid evidence) \u2192 `POST /contracts/{id}/decide` (AUTHORIZE / DENY / ABSTAIN / REFRESH / ESCALATE) \u2192\n`POST /decisions/{id}/execute` (403 unless AUTHORIZE; authorize + protected execution on the EvidenceGate) \u2192\n`GET /receipts/{id}` \u2192 `POST /receipts/{id}/replay`.\n",
    "title": "SUFFICIA API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
