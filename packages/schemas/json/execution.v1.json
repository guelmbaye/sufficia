{
  "$defs": {
    "ExecutionStatus": {
      "enum": [
        "BLOCKED",
        "SUBMITTED",
        "EXECUTED",
        "FAILED"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "default": "USDC",
          "title": "Currency",
          "type": "string"
        },
        "value": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "$id": "https://sufficia.dev/schemas/execution.v1.json",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authorization_id": {
      "title": "Authorization Id",
      "type": "string"
    },
    "block_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Block Number"
    },
    "chain_id": {
      "title": "Chain Id",
      "type": "integer"
    },
    "confirmed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "execution_id": {
      "title": "Execution Id",
      "type": "string"
    },
    "network": {
      "title": "Network",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "tx_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tx Hash"
    }
  },
  "required": [
    "execution_id",
    "authorization_id",
    "status",
    "network",
    "chain_id"
  ],
  "title": "Execution",
  "type": "object"
}
