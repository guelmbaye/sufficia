# =============================================================================================
# SUFFICIA — environment configuration (copy to apps/api/.env or export in your shell)
# Every variable is optional: with none set, the API runs the demo profile on an in-process EVM
# executing the real EvidenceGate bytecode (CHAIN_MODE=LOCAL_EVM). Private keys stay server-side.
# =============================================================================================

# ---- application -----------------------------------------------------------------------------
APP_ENV=development
DEMO_MODE=true                      # Demo Lab + scenario endpoints (404 when false)
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./sufficia.db   # or postgresql://sufficia:sufficia@localhost:5432/sufficia
API_KEY=                            # when set, every POST/PUT needs header X-API-Key
RATE_LIMIT_PER_MINUTE=240           # mutating requests per client IP (0 disables)
MAX_REQUEST_BYTES=262144

# ---- intent compiler -------------------------------------------------------------------------
INTENT_COMPILER=auto                # deterministic | llm | auto (llm only when a key is set)
ANTHROPIC_API_KEY=                  # optional: LLM drafts are accepted only if they preserve the intent
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=20

# ---- policy defaults used when compiling intents --------------------------------------------------
DEFAULT_MAX_AGE_SECONDS=30
DEFAULT_AUTHORIZATION_TTL_SECONDS=30   # onchain maximum is 600 (EvidenceGate.MAX_AUTHORIZATION_TTL)
DEFAULT_EVIDENCE_BUDGET_USDC=0.25
DEFAULT_CONFLICT_TOLERANCE=0.10
DEFAULT_MINIMUM_REQUIRED_EVIDENCE=3
MAX_PROTECTED_AMOUNT_USDC=1000

# ---- chain -----------------------------------------------------------------------------------------
CHAIN_MODE=LOCAL_EVM                # LOCAL_EVM | MONAD_TESTNET | MONAD_MAINNET | DISABLED
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_RPC_FALLBACK_URL=https://rpc.ankr.com/monad_testnet
MONAD_CHAIN_ID=10143                # 143 for mainnet
MONAD_EXPLORER_URL=https://testnet.monadvision.com
DEPLOYMENT_FILE=                    # e.g. ../../deployments/monad-testnet.json (written by `make deploy-testnet`)
GATE_USDC_FUNDING=                  # demo dUSDC base units minted to the gate at deployment (Monad default 100000000000 = 100,000)
EVIDENCE_GATE_ADDRESS=              # or explicit addresses instead of DEPLOYMENT_FILE
USDC_ADDRESS=
TOKEN_X_ADDRESS=
SWAP_ROUTER_ADDRESS=
# Keys: fresh testnet-only keys, kept in apps/api/.env (gitignored). `python scripts/testnet.py keys` creates all four
# there; `python scripts/testnet.py status` says what is missing; `python scripts/preflight.py` checks balances, roles
# and the clock before deploying and before a demo.
DEPLOYER_PRIVATE_KEY=               # deploy script and scripts/fund_gate.py only
AUTHORIZER_PRIVATE_KEY=             # holds AUTHORIZER_ROLE on the EvidenceGate
EXECUTOR_PRIVATE_KEY=               # the only address allowed to call executeAuthorized
PAUSER_PRIVATE_KEY=
EXECUTION_ADAPTER=demo_swap         # demo_swap | transfer
EXECUTION_RECIPIENT=                # defaults to the EvidenceGate itself (protected treasury)
SLIPPAGE_BPS=100
TX_CONFIRMATION_TIMEOUT_SECONDS=30
COMMIT_RECEIPTS_ONCHAIN=true        # EvidenceGate.recordReceipt(authorizationId, receiptHash)

# ---- evidence sources ---------------------------------------------------------------------------------
EVIDENCE_PROFILE=demo               # demo | live | recorded  (see apps/api/sufficia/config.py DEFAULT_SOURCES)
EVIDENCE_SOURCES_JSON=              # override, e.g. {"available_liquidity":["dexscreener","uniswap_v2_pool"]}
HTTP_TIMEOUT_SECONDS=6
ASSET_TOKEN_ADDRESS=                # token queried at data providers (live profile)
NANSEN_API_KEY=
NANSEN_BASE_URL=https://api.nansen.ai
NANSEN_CHAIN=monad
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_CHAIN_ID=monad
DEXSCREENER_PAIR_ADDRESS=
CHAINLINK_FEED_ADDRESS=
CHAINLINK_RPC_URL=
POOL_ADDRESS=                       # Uniswap-V2-style pair for onchain liquidity
POOL_QUOTE_TOKEN_INDEX=1
POOL_QUOTE_DECIMALS=6

# ---- x402 paid evidence (Monad facilitator supports x402 v2) --------------------------------------------
X402_ENABLED=true
X402_NETWORK=eip155:10143
X402_ASSET=0x534b2f3A21130d7a60830c2Df862319e593943A3   # Monad testnet USDC (EIP-712 "USDC" v2)
X402_ASSET_NAME=USDC
X402_ASSET_VERSION=2
X402_FACILITATOR=https://x402-facilitator.molandak.org
X402_MAX_PER_REQUEST_USDC=0.10
X402_PAY_TO_ALLOWLIST=              # comma-separated payTo addresses accepted (empty = any passing other checks)
X402_EVIDENCE_URL=                  # live paid endpoint returning SUFFICIA evidence JSON
EVIDENCE_PAYMENT_PRIVATE_KEY=       # evidence wallet (signs EIP-3009 authorizations; never the executor key)
X402_REFERENCE_ENABLED=true         # local reference resource server under /_dev/x402 (SIMULATED settlement)
X402_REFERENCE_PRICE_USDC=0.02
X402_REFERENCE_PAY_TO=0x000000000000000000000000000000000000dEaD
